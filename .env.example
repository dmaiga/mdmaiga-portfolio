# URL absolue du site — métadonnées, canoniques, sitemap, images Open Graph.
# Optionnelle au build (repli signalé dans lib/site.ts). À définir sur Vercel.
NEXT_PUBLIC_SITE_URL=https://portfolio-freelance.vercel.app

# Clé publique Web3Forms pour le formulaire de contact.
# Absente → le formulaire n'est pas affiché, l'e-mail reste visible et cliquable.
# NEXT_PUBLIC_WEB3FORMS_KEY=
